# Server-side only. Keep .env private; never commit credentials.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
FDC_API_KEY=
PORT=4173
HOST=127.0.0.1
# Required when binding a non-loopback address:
APP_ORIGIN=
APP_PASSWORD=

# Default disabled. Enable only after configuring credentials and choosing a provider.
LIVE_CALLS_ENABLED=false
VISION_PROVIDER=OpenAI
VISION_PROTOCOL=responses
VISION_ENDPOINT=https://api.openai.com/v1/responses
# For chat-completions-compatible vendors set these instead of OPENAI_*:
VISION_API_KEY=
VISION_MODEL=
